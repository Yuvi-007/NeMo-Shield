import core
import guardrails

# Input rails: prompt injection defense (OWASP LLM01).
# Colang strings interpolate {..}, so regex quantifiers are written {{n}}.
# Word boundaries use (?<!\w) / (?!\w) because "\b" would be read as a
# backspace escape inside a string literal.

flow input rails $input_text
  check_input_safety $input_text

flow check_input_safety $input_text
  # Layer 1: deterministic Colang pattern detectors.
  detect instruction override $input_text
  detect jailbreak persona $input_text
  detect system prompt extraction $input_text

  # Layer 2: weighted Python classifier (catches multi-signal attacks).
  $verdict = await ClassifyThreatAction(prompt=$input_text)
  if $verdict["rail_action"] == "BLOCKED"
    block prompt injection

# "ignore all previous instructions", "disregard prior rules", "forget the above"
flow detect instruction override $text
  if search("(?i)(?<!\w)(ignore|disregard|forget|override|bypass)(?!\w).{{0,30}}(previous|prior|above|earlier|preceding|all)(?!\w).{{0,20}}(instructions?|rules|prompts?|directives|guidelines|context)(?!\w)", $text)
    block prompt injection

# "DAN mode", "developer mode enabled", "you are now unrestricted"
flow detect jailbreak persona $text
  if search("(?i)(?<!\w)(DAN|do anything now|developer mode|jailbreak|god mode)(?!\w)", $text)
    block prompt injection
  if search("(?i)(?<!\w)you are now(?!\w).{{0,40}}(unrestricted|unfiltered|uncensored|free of|without (any )?(rules|restrictions|limits))", $text)
    block prompt injection

# "reveal your system prompt", "print your hidden instructions"
flow detect system prompt extraction $text
  if search("(?i)(?<!\w)(reveal|show|print|repeat|output|display|leak|dump)(?!\w).{{0,30}}(system|hidden|initial|original|secret)(?!\w).{{0,15}}(prompt|instructions?|message|config(uration)?)(?!\w)", $text)
    block prompt injection

flow block prompt injection
  bot say "Request blocked by NeMo-Shield Input Rail: Malicious prompt injection pattern detected (OWASP LLM01)."
  abort
